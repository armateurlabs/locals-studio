{
  "name": "locals-studio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/build-info.test.mjs tests/frontend.test.mjs tests/macos-installer.test.mjs && tsx --test tests/catalogue.test.ts tests/model-parameters.test.ts tests/model-logo.test.tsx tests/ui.test.tsx tests/discover-dates.test.tsx",
    "tauri": "tauri",
    "desktop": "node scripts/prepare-sidecar.mjs debug && tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "installer:build": "node scripts/build-macos-pkg.mjs",
    "installer:verify": "node scripts/verify-macos-pkg.mjs",
    "test:ui": "tsx --test tests/ui.test.tsx tests/discover-dates.test.tsx",
    "icons:generate": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react-test-renderer": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
